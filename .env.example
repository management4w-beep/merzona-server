# These are pre-filled with ready-to-use random secrets - matches the values in README.md's
# quick checklist (step 5). Copy this whole block into Railway's Variables tab (or a local
# .env file) and only fill in OWNER_WHATSAPP_NUMBER yourself. Leave GROUP_ID and
# PUBLIC_BASE_URL blank until step 6-8 in the README (they don't exist until you deploy).

# Used by the WhatsApp-notify feature (send-quotation) - also goes into
# Quotation_Generator.html's WHATSAPP_NOTIFY_TOKEN.
AUTH_TOKEN=SWkEojES13KEGpg0Rib3cfQrRUQI6Nky

# Used by the login-approval feature - approve/deny/revoke links, and the one-time
# "owner bypass" (#owner=...) link you open once on your own devices.
ADMIN_TOKEN=NqxhZ6sVAQIAENZcdCKVKFjDfCv12JJV

# The domain the Merzona tool runs on - leave as-is unless it changes
ALLOWED_ORIGIN=https://management4w-beep.github.io

# ✏️ Your own personal WhatsApp number - digits only, with country code, no + or spaces
# (e.g. UAE number 050-123-4567 becomes 971501234567). This is who gets notified whenever
# someone requests access, or a quotation is ready to post to the Tasks group.
OWNER_WHATSAPP_NUMBER=

# The ID of the "Tasks" WhatsApp group - leave blank until after first deploy, then find it
# by opening /groups?token=SWkEojES13KEGpg0Rib3cfQrRUQI6Nky . Looks like: 120363012345678901@g.us
GROUP_ID=

# The ID of your signed-contracts WhatsApp group (e.g. "العقود") - same way as GROUP_ID above,
# used by the electronic contract-signing feature. Leave blank if you haven't set that up yet.
CONTRACTS_GROUP_ID=

# The public URL this server is reachable at once deployed (no trailing slash) - leave blank
# until Railway gives you one, e.g. https://your-app.up.railway.app
PUBLIC_BASE_URL=

# Port - Railway sets this automatically, you normally don't need to touch it
PORT=3000
